        "#이미지 출력을 위한 전처리\n",
        "def normalize_image(image):\n",
        "    image_min=image.min()\n",
        "    image_max=image.max()\n",
        "    image.clamp_(min=image_min, max=image_max)\n",
        "    image.add_(-image_min).div_(image_max-image_min+1e-5)   #torch.add: 더하라는 메서드\n",
        "    return image"
      ],
      "metadata": {
