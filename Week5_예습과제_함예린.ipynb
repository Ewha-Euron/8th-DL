      "source": [
        "#이미지 데이터셋 정의\n",
        "train_dataset=DogvsCatDataset(train_images_filepaths, transform=ImageTransform(size,\n",
        "                                mean, std), phase='train')\n",
        "val_dataset=DogvsCatDataset(val_images_filepaths, transform=ImageTransform(size,\n",
